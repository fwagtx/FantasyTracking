 "phrases": [
  {
   "text": "Esta es la tienda de objetos de hoy, 12 de noviembre.",
   "t0": 0.2,
   "t1": 2.505
  },
  {
   "text": "\u00a1Tres cosas antes de gastar un solo pavo!",
   "t0": 2.635,
   "t1": 4.555
  },
  {
   "text": "El Lote A$AP Rocky:",
   "t0": 4.8,
   "t1": 5.56
  },
  {
   "text": "3200 pavos, en vez de 8800.",
   "t0": 5.62,
   "t1": 8.55
  },
  {
   "text": "\u00a1Te ahorras 5600!",
   "t0": 8.7,
   "t1": 10.27
  },
  {
   "text": "Arquetipo y Superador est\u00e1n en la tienda.",
   "t0": 10.53,
   "t1": 12.45
  },
  {
   "text": "Las dos son del Cap\u00edtulo 1, Temporada 5.",
   "t0": 12.56,
   "t1": 14.811
  },
  {
   "text": "Y 14 skins est\u00e1n en su \u00faltimo d\u00eda, ocho de ellas \u00e9picas.",
   "t0": 15.071,
   "t1": 18.066
  },
  {
   "text": "\u00bfVas a comprar algo hoy?",
   "t0": 18.411,
   "t1": 19.456
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos. Le ayuda much\u00edsimo al canal.",
   "t0": 19.566,
   "t1": 23.001
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 23.251,
   "t1": 25.779
  }
 ],
