 "phrases": [
  {
   "text": "Las cinco skins de la tienda de hoy que m\u00e1s tardaron en volver.",
   "t0": 0.2,
   "t1": 2.72
  },
  {
   "text": "\u00a1Y espera al n\u00famero uno!",
   "t0": 2.92,
   "t1": 3.89
  },
  {
   "text": "N\u00famero cinco: Stormtrooper samur\u00e1i.",
   "t0": 4.14,
   "t1": 5.935
  },
  {
   "text": "Volvi\u00f3 despu\u00e9s de\u2026",
   "t0": 6.135,
   "t1": 6.994
  },
  {
   "text": "\u00a1186 d\u00edas!",
   "t0": 6.994,
   "t1": 8.175
  },
  {
   "text": "La \u00faltima vez fue el 7 de mayo de 2026.",
   "t0": 8.39,
   "t1": 10.855
  },
  {
   "text": "N\u00famero cuatro: Darth Vader samur\u00e1i.",
   "t0": 11.055,
   "t1": 12.68
  },
  {
   "text": "Volvi\u00f3 despu\u00e9s de\u2026",
   "t0": 12.88,
   "t1": 13.68
  },
  {
   "text": "\u00a1Tambi\u00e9n 186 d\u00edas!",
   "t0": 14.28,
   "t1": 15.844
  },
  {
   "text": "La \u00faltima vez fue el 7 de mayo de 2026.",
   "t0": 16.044,
   "t1": 18.529
  },
  {
   "text": "N\u00famero tres: Sincopador.",
   "t0": 18.729,
   "t1": 20.079
  },
  {
   "text": "Volvi\u00f3 despu\u00e9s de\u2026",
   "t0": 20.279,
   "t1": 21.034
  },
  {
   "text": "\u00a1347 d\u00edas!",
   "t0": 21.634,
   "t1": 23.099
  },
  {
   "text": "La \u00faltima vez fue el 27 de noviembre de 2025.",
   "t0": 23.349,
   "t1": 26.339
  },
  {
   "text": "N\u00famero dos: Especialista en tiros libres.",
   "t0": 26.539,
   "t1": 28.649
  },
  {
   "text": "Volvi\u00f3 despu\u00e9s de\u2026",
   "t0": 28.849,
   "t1": 29.634
  },
  {
   "text": "\u00a1457 d\u00edas!",
   "t0": 30.234,
   "t1": 31.812
  },
  {
   "text": "La \u00faltima vez fue el 9 de agosto de 2025.",
   "t0": 32.013,
   "t1": 34.558
  },
  {
   "text": "\u00a1Y se va hoy!",
   "t0": 34.758,
   "t1": 35.373
  },
  {
   "text": "\u00bfY el n\u00famero uno?",
   "t0": 35.673,
   "t1": 36.418
  },
  {
   "text": "\u00a1Asesora de envoltorios!",
   "t0": 37.018,
   "t1": 38.178
  },
  {
   "text": "Volvi\u00f3 despu\u00e9s de\u2026",
   "t0": 38.328,
   "t1": 39.063
  },
  {
   "text": "\u00a1473 d\u00edas!",
   "t0": 39.663,
   "t1": 41.143
  },
  {
   "text": "La \u00faltima vez fue el 24 de julio de 2025.",
   "t0": 41.393,
   "t1": 44.258
  },
  {
   "text": "\u00a1Y se va hoy!",
   "t0": 44.438,
   "t1": 44.958
  },
  {
   "text": "\u00bfCu\u00e1l te llevas? D\u00edmelo en los comentarios.",
   "t0": 45.258,
   "t1": 47.056
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos. Le ayuda much\u00edsimo al canal.",
   "t0": 47.256,
   "t1": 50.796
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 51.046,
   "t1": 53.601
  }
 ],
