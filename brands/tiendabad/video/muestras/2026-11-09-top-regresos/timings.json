 "phrases": [
  {
   "text": "Las cinco skins de la tienda de hoy que m\u00e1s tardaron en volver.",
   "t0": 0.2,
   "t1": 2.72
  },
  {
   "text": "N\u00famero cinco: Stormtrooper samur\u00e1i.",
   "t0": 2.92,
   "t1": 4.745
  },
  {
   "text": "Volvi\u00f3 despu\u00e9s de\u2026",
   "t0": 4.945,
   "t1": 5.878
  },
  {
   "text": "\u00a1186 d\u00edas!",
   "t0": 5.878,
   "t1": 7.0
  },
  {
   "text": "N\u00famero cuatro: Darth Vader samur\u00e1i.",
   "t0": 7.2,
   "t1": 8.805
  },
  {
   "text": "Volvi\u00f3 despu\u00e9s de\u2026",
   "t0": 9.005,
   "t1": 9.765
  },
  {
   "text": "\u00a1Tambi\u00e9n 186 d\u00edas!",
   "t0": 10.265,
   "t1": 11.82
  },
  {
   "text": "N\u00famero tres: Sincopador.",
   "t0": 12.02,
   "t1": 13.315
  },
  {
   "text": "Volvi\u00f3 despu\u00e9s de\u2026",
   "t0": 13.515,
   "t1": 14.29
  },
  {
   "text": "\u00a1347 d\u00edas!",
   "t0": 14.79,
   "t1": 16.201
  },
  {
   "text": "N\u00famero dos: Especialista en tiros libres.",
   "t0": 16.401,
   "t1": 18.346
  },
  {
   "text": "Volvi\u00f3 despu\u00e9s de\u2026",
   "t0": 18.546,
   "t1": 19.226
  },
  {
   "text": "\u00a1457 d\u00edas!",
   "t0": 19.726,
   "t1": 21.361
  },
  {
   "text": "\u00a1Y se va hoy!",
   "t0": 21.596,
   "t1": 22.211
  },
  {
   "text": "\u00bfY el n\u00famero uno?",
   "t0": 22.861,
   "t1": 23.586
  },
  {
   "text": "\u00a1Asesora de envoltorios!",
   "t0": 23.586,
   "t1": 24.721
  },
  {
   "text": "Volvi\u00f3 despu\u00e9s de\u2026",
   "t0": 24.871,
   "t1": 25.621
  },
  {
   "text": "\u00a1473 d\u00edas!",
   "t0": 26.121,
   "t1": 27.611
  },
  {
   "text": "La \u00faltima vez fue el 24 de julio de 2025.",
   "t0": 27.861,
   "t1": 30.751
  },
  {
   "text": "\u00a1Y se va hoy!",
   "t0": 30.951,
   "t1": 31.511
  },
  {
   "text": "\u00bfCu\u00e1l te llevas? D\u00edmelo abajo.",
   "t0": 32.161,
   "t1": 33.564
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos.",
   "t0": 33.764,
   "t1": 35.774
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 36.034,
   "t1": 38.587
  }
 ],
