 "phrases": [
  {
   "text": "\u00a1Tres mitos de la Tienda Pirata que tienes que dejar de creer!",
   "t0": 0.2,
   "t1": 2.64
  },
  {
   "text": "Mito uno: la br\u00fajula del token. No existe.",
   "t0": 2.95,
   "t1": 5.005
  },
  {
   "text": "Mito dos: tu skin cambia la probabilidad. Falso, la skin no importa.",
   "t0": 5.255,
   "t1": 8.83
  },
  {
   "text": "Mito tres: los nuevos tienen ventaja. Falso, todos tienen la misma probabilidad.",
   "t0": 9.08,
   "t1": 13.04
  },
  {
   "text": "\u00bfCu\u00e1l te hab\u00edas cre\u00eddo?",
   "t0": 13.33,
   "t1": 14.293
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos. Le ayuda much\u00edsimo al canal.",
   "t0": 14.542,
   "t1": 18.082
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 18.332,
   "t1": 20.887
  }
 ],
