 "phrases": [
  {
   "text": "\u00bfY si hoy te sale la Tienda Pirata? Esto se va hoy de la tienda.",
   "t0": 0.2,
   "t1": 3.12
  },
  {
   "text": "El Lote Amos del universo.",
   "t0": 3.32,
   "t1": 4.64
  },
  {
   "text": "Trae 3 skins, 4 mochilas, 4 picos y 2 gestos.",
   "t0": 4.875,
   "t1": 7.79
  },
  {
   "text": "Cuesta 3600 pavos, y normalmente 6700.",
   "t0": 8.04,
   "t1": 11.385
  },
  {
   "text": "Y se va hoy a las 6 de la tarde, hora de la Ciudad de M\u00e9xico.",
   "t0": 11.635,
   "t1": 14.318
  },
  {
   "text": "Con la Tienda Pirata, te lo llevar\u00edas sin gastar ni un pavo. \u00bfTe lo llevar\u00edas?",
   "t0": 14.518,
   "t1": 18.113
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos.",
   "t0": 18.363,
   "t1": 20.303
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 20.573,
   "t1": 23.102
  }
 ],
