 "phrases": [
  {
   "text": "\u00a1Quedan 21 d\u00edas para encontrar la Tienda Pirata!",
   "t0": 0.2,
   "t1": 2.665
  },
  {
   "text": "La b\u00fasqueda del tesoro termina el 5 de diciembre.",
   "t0": 2.965,
   "t1": 5.325
  },
  {
   "text": "Y recuerda: sale en 1 de cada 137 500 cofres.",
   "t0": 5.62,
   "t1": 9.35
  },
  {
   "text": "Dato del d\u00eda: \u00a1hoy hay Horas del Tesoro!",
   "t0": 9.63,
   "t1": 11.564
  },
  {
   "text": "La segunda ronda es de 8 a 10 de la noche, hora de la Ciudad de M\u00e9xico, y la probabilidad sube 1.5 veces.",
   "t0": 11.814,
   "t1": 16.859
  },
  {
   "text": "\u00bfYa te sali\u00f3? D\u00edmelo en los comentarios.",
   "t0": 17.159,
   "t1": 19.049
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos.",
   "t0": 19.269,
   "t1": 21.204
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 21.469,
   "t1": 24.023
  }
 ],
