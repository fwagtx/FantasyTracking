 "phrases": [
  {
   "text": "La Tienda Pirata no te da todo. \u00a1Esto es lo que no incluye!",
   "t0": 0.2,
   "t1": 2.845
  },
  {
   "text": "No puedes reclamar niveles del pase de batalla.",
   "t0": 3.145,
   "t1": 5.21
  },
  {
   "text": "Tampoco lotes que se pagan con dinero real, y no puedes regalar objetos.",
   "t0": 5.51,
   "t1": 8.755
  },
  {
   "text": "Y solo puedes reclamar un sidekick.",
   "t0": 9.005,
   "t1": 10.61
  },
  {
   "text": "\u00bfLo sab\u00edas?",
   "t0": 10.86,
   "t1": 11.46
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos. Le ayuda much\u00edsimo al canal.",
   "t0": 11.71,
   "t1": 15.224
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 15.474,
   "t1": 18.075
  }
 ],
