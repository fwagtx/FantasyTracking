 "phrases": [
  {
   "text": "\u00a1Quedan 8 d\u00edas para encontrar la Tienda Pirata!",
   "t0": 0.2,
   "t1": 2.34
  },
  {
   "text": "La b\u00fasqueda del tesoro termina el 5 de diciembre.",
   "t0": 2.64,
   "t1": 5.0
  },
  {
   "text": "Y recuerda: sale en 1 de cada 137 500 cofres.",
   "t0": 5.27,
   "t1": 9.105
  },
  {
   "text": "Dato del d\u00eda: ma\u00f1ana hay Horas del Tesoro.",
   "t0": 9.355,
   "t1": 11.473
  },
  {
   "text": "De 1 a 3 de la tarde y de 8 a 10 de la noche, hora de la Ciudad de M\u00e9xico, la probabilidad sube 1.5 veces.",
   "t0": 11.724,
   "t1": 16.969
  },
  {
   "text": "\u00bfYa te sali\u00f3? D\u00edmelo en los comentarios.",
   "t0": 17.269,
   "t1": 19.224
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos.",
   "t0": 19.434,
   "t1": 21.379
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 21.664,
   "t1": 24.217
  }
 ],
