 "phrases": [
  {
   "text": "\u00a1Hoy hay Horas del Tesoro en Fortnite! Estos son los horarios.",
   "t0": 0.2,
   "t1": 2.985
  },
  {
   "text": "La primera es de 1 a 3 de la tarde, hora de la Ciudad de M\u00e9xico.",
   "t0": 3.285,
   "t1": 6.045
  },
  {
   "text": "La segunda, de 8 a 10 de la noche.",
   "t0": 6.295,
   "t1": 7.935
  },
  {
   "text": "Y en las dos, la probabilidad de la Tienda Pirata sube 1.5 veces.",
   "t0": 8.185,
   "t1": 11.06
  },
  {
   "text": "\u00bfA cu\u00e1l te vas a conectar?",
   "t0": 11.36,
   "t1": 12.43
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos. Le ayuda much\u00edsimo al canal.",
   "t0": 12.68,
   "t1": 16.225
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 16.475,
   "t1": 19.076
  }
 ],
