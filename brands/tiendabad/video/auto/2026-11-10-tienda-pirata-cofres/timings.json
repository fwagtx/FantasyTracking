 "phrases": [
  {
   "text": "\u00bfQu\u00e9 cofres cuentan para la Tienda Pirata? \u00a1Te lo explico r\u00e1pido!",
   "t0": 0.2,
   "t1": 3.01
  },
  {
   "text": "Cuenta en Battle Royale y en Cero Construcci\u00f3n.",
   "t0": 3.31,
   "t1": 5.365
  },
  {
   "text": "Y sirve cualquier cofre: normales, raros, enterrados, de reliquia\u2026 \u00a1todos!",
   "t0": 5.665,
   "t1": 9.085
  },
  {
   "text": "El premio no sale del cofre: te aparece un mensaje en la pantalla.",
   "t0": 9.335,
   "t1": 12.37
  },
  {
   "text": "\u00bfCu\u00e1ntos cofres abriste hoy?",
   "t0": 12.67,
   "t1": 13.935
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos. Le ayuda much\u00edsimo al canal.",
   "t0": 14.185,
   "t1": 17.725
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 17.975,
   "t1": 20.53
  }
 ],
