 "phrases": [
  {
   "text": "Lo nuevo m\u00e1s caro de la tienda de hoy\u2026 \u00a1y con la Tienda Pirata te lo llevar\u00edas sin gastar ni un pavo!",
   "t0": 0.2,
   "t1": 4.26
  },
  {
   "text": "N\u00famero cinco: Lote de Equipo de arbitraje.",
   "t0": 4.46,
   "t1": 6.44
  },
  {
   "text": "Cuesta\u2026",
   "t0": 6.64,
   "t1": 7.21
  },
  {
   "text": "\u00a12000 pavos!",
   "t0": 7.71,
   "t1": 8.405
  },
  {
   "text": "Y empatado: Lote de \u00c1rbitro renegado.",
   "t0": 8.605,
   "t1": 10.04
  },
  {
   "text": "N\u00famero cuatro: LOTE BECKY LYNCH Y BIANCA BELAIR.",
   "t0": 10.24,
   "t1": 12.28
  },
  {
   "text": "Cuesta\u2026",
   "t0": 12.48,
   "t1": 13.13
  },
  {
   "text": "\u00a12400 pavos!",
   "t0": 13.63,
   "t1": 14.66
  },
  {
   "text": "N\u00famero tres: Lote KizunaAI.",
   "t0": 14.86,
   "t1": 16.42
  },
  {
   "text": "Cuesta\u2026",
   "t0": 16.62,
   "t1": 16.924
  },
  {
   "text": "\u00a13200 pavos!",
   "t0": 17.424,
   "t1": 18.694
  },
  {
   "text": "N\u00famero dos: LOTE PUNTO EXTRA.",
   "t0": 18.894,
   "t1": 20.374
  },
  {
   "text": "Cuesta\u2026",
   "t0": 20.574,
   "t1": 21.194
  },
  {
   "text": "\u00a13500 pavos!",
   "t0": 21.694,
   "t1": 22.594
  },
  {
   "text": "\u00bfY el n\u00famero uno?",
   "t0": 22.794,
   "t1": 23.739
  },
  {
   "text": "\u00a1LOTE CARRERA DEFINITIVA!",
   "t0": 24.339,
   "t1": 25.394
  },
  {
   "text": "Cuesta\u2026",
   "t0": 25.544,
   "t1": 25.844
  },
  {
   "text": "\u00a1Tambi\u00e9n 3500 pavos!",
   "t0": 26.344,
   "t1": 27.884
  },
  {
   "text": "Y su precio normal es de 7500.",
   "t0": 28.084,
   "t1": 30.124
  },
  {
   "text": "\u00a1Con la Tienda Pirata: cero pavos!",
   "t0": 30.324,
   "t1": 31.807
  },
  {
   "text": "Con la Tienda Pirata, todo lo que cuesta pavos es gratis por 14 d\u00edas. \u00bfCu\u00e1l te llevar\u00edas?",
   "t0": 32.457,
   "t1": 36.872
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos.",
   "t0": 37.072,
   "t1": 38.992
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 39.257,
   "t1": 41.766
  }
 ],
