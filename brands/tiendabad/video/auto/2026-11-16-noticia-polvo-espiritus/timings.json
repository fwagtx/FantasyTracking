 "mode": "flow",
 "duration": 32.29,
 "phrases": [
  {
   "text": "\u00a1Noticia nueva en Fortnite! Esto dice el juego:",
   "t0": 0.2,
   "t1": 2.347
  },
  {
   "text": "\u00a1Te espera un mont\u00f3n de bot\u00edn para saquear!",
   "t0": 2.348,
   "t1": 4.495
  },
  {
   "text": "Doble polvo de esp\u00edritus y PE, adem\u00e1s de cofres de esp\u00edritus potenciados y carteles de Se busca de esp\u00edritus.",
   "t0": 4.695,
   "t1": 9.95
  },
  {
   "text": "O sea: en tus partidas ganas el doble de polvo de esp\u00edritus y el doble de PE.",
   "t0": 10.28,
   "t1": 14.032
  },
  {
   "text": "Y hay cofres de esp\u00edritus potenciados, y carteles de Se busca de esp\u00edritus.",
   "t0": 14.232,
   "t1": 17.777
  },
  {
   "text": "Y recuerda: cualquier cofre que abras en Battle Royale o Cero construcci\u00f3n puede darte la Tienda Pirata.",
   "t0": 18.027,
   "t1": 22.712
  },
  {
   "text": "\u00bfYa lo aprovechaste? \u00a1Cu\u00e9ntame en los comentarios!",
   "t0": 23.012,
   "t1": 25.292
  },
  {
   "text": "Usa el c\u00f3digo BAD en la tienda de objetos. Le ayuda much\u00edsimo al canal.",
   "t0": 25.522,
   "t1": 29.138
  },
  {
   "text": "\u00a1Gracias por ver! S\u00edguenos para m\u00e1s contenido diario.",
   "t0": 29.388,
   "t1": 31.99
  }
 ],
